# Имя твоего проекта
PROJECT_NAME           = "My Qt Server Project"

# Язык документации (сделает интерфейс HTML-страниц на русском)
OUTPUT_LANGUAGE        = Russian

# Укажи кодировку, чтобы не было «кракозябр» (для Qt-проектов обычно UTF-8)
DOXYFILE_ENCODING      = UTF-8

# Путь к исходникам. Точка (.) означает текущую папку
INPUT                  = .

# Какие типы файлов анализировать
FILE_PATTERNS          = *.cpp *.h

# Если хочешь, чтобы Doxygen заходил в подпапки проекта
RECURSIVE              = YES

# Папка, куда сохранится готовая документация
OUTPUT_DIRECTORY       = ./doc

# Если нужно извлечь документацию, даже если у класса нет комментария /** ... */
EXTRACT_ALL            = YES
